{
  "manifest_version": 3,
  "name": "闲鱼管理 · 登录同步",
  "version": "0.2.1",
  "description": "把浏览器里闲鱼（goofish.com）的登录同步给闲鱼管理后台，浏览器续期后也会跟着同步。",
  "icons": {
    "16": "icons/frog-16.png",
    "32": "icons/frog-32.png",
    "48": "icons/frog-48.png",
    "128": "icons/frog-128.png"
  },
  "permissions": [
    "cookies",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.goofish.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "闲鱼登录同步",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/frog-16.png",
      "32": "icons/frog-32.png"
    }
  }
}
