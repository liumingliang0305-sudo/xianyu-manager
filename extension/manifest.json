{
  "manifest_version": 3,
  "name": "闲鱼管理 · 登录同步",
  "version": "0.1.0",
  "description": "把浏览器里闲鱼（goofish.com）的登录同步给本机的闲鱼管理后台，浏览器续期后也会跟着同步。",
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": [
    "https://*.goofish.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "闲鱼登录同步",
    "default_popup": "popup.html"
  }
}
